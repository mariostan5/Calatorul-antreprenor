---
// l2 is the headline's key word(s): set in italic serif
interface Props { num: string; name: string; l1: string; l2: string; sub: string }
const { num, name, l1, l2, sub } = Astro.props;
---
<header class="page-head" data-nofocus>
  <p class="label kicker">{num} / {name}</p>
  <h1 class="page-title" data-split>{l1} <em>{l2}</em></h1>
  <p class="page-sub" data-reveal>{sub}</p>
  <a class="page-back label" href="/">← Înapoi acasă</a>
</header>

<style is:global>
  .page-head { margin: 0 auto; padding: calc(64px + 16vh) var(--pad) 10vh; border-bottom: 1px solid var(--line); }
  .page-title { max-width: 16ch; margin: 24px 0 28px; font-size: clamp(44px, 7.4vw, 128px); line-height: .94; letter-spacing: -.01em; }
  .page-sub { max-width: 52ch; font-size: clamp(16px, 1.3vw, 20px); color: var(--muted); }
  .page-back { display: inline-block; margin-top: 34px; color: var(--fg); border-bottom: 1px solid var(--accent-ink); padding-bottom: 2px; }
  .page-body { background: var(--bg); }
</style>
