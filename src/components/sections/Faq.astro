---
// Answers in [brackets] are placeholders to be written by the team.
const groups = [
  {
    name: 'Club',
    items: [
      ['Ce este Clubul Călătorul Antreprenor?', 'Un club de călătorii pentru români din toată lumea: vacanțe de grup, prețuri de membru la hoteluri de 4–5★ și o comunitate de peste 700 de oameni.'],
      ['Ce primesc ca membru?', 'Puncte de călătorie în fiecare lună, un voucher de bun venit pentru prima vacanță, cashback la hoteluri și croaziere și acces la excursiile de grup ale comunității.'],
      ['Pot folosi beneficiile pentru familie?', 'Da, poți rezerva vacanțe pentru tine și pentru familia ta, în oricare dintre cele peste 2.000 de destinații disponibile.'],
      ['Pot renunța la abonament?', 'Da, poți renunța oricând. Detaliile despre punctele acumulate le găsești în condițiile abonamentului, prezentate la webinar.'],
    ],
  },
  {
    name: 'Business',
    items: [
      ['Este MLM?', '[Răspuns de completat de echipă.]'],
      ['Cât timp îmi ia?', '[Răspuns de completat de echipă.]'],
      ['Trebuie să construiesc o afacere ca să fiu membru?', 'Nu. Mulți membri vin doar pentru călătorii. Business Class e un drum separat, pentru cei care vor să învețe și să construiască ceva al lor.'],
      ['Ce rezultate pot avea?', 'Rezultatele diferă de la om la om și depind de timpul și efortul investit. Nu promitem venituri. Detalii în nota despre venituri.'],
    ],
  },
  {
    name: 'Webinar',
    items: [
      ['Când are loc webinarul?', 'În fiecare joi, la 21:00, ora României. Durează aproximativ 45 de minute și este gratuit.'],
      ['Ce aflu la webinar?', 'Cum funcționează clubul, ce primești ca membru, excursiile de grup programate și cum arată partea de Business Class.'],
      ['Dacă nu pot participa joi?', 'Webinarul rulează și înregistrat. După înscriere primești toate detaliile.'],
    ],
  },
];
---
<section class="faq" id="intrebari">
  <div class="faq-grid">
    <div class="faq-head">
      <span class="label kicker">Întrebări frecvente</span>
      <h2 class="h2 h2-md" data-split>Tot ce trebuie să știi înainte de îmbarcare.</h2>
      <p data-reveal>Nu găsești răspunsul? Scrie-ne pe WhatsApp și îți răspundem noi.</p>
    </div>
    <div class="faq-list">
      {groups.map((g) => (
        <div class="faq-group">
          <h3 class="label">{g.name}</h3>
          {g.items.map(([q, a]) => (
            <details>
              <summary>{q}<i aria-hidden="true"></i></summary>
              <p>{a}</p>
            </details>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>

<style is:global>
  .faq { padding: 24vh var(--pad); }
  .faq-grid { display: grid; grid-template-columns: .8fr 1.2fr; gap: clamp(80px, 8vw, 140px); max-width: 1400px; margin: 0 auto; align-items: start; }
  .faq-head { position: sticky; top: 18vh; }
  .faq-head p { margin-top: 22px; color: rgba(243, 238, 228, .72); }
  .faq-group + .faq-group { margin-top: 56px; }
  .faq-group h3 { margin-bottom: 14px; color: var(--gold); }
  .faq-list details { border-top: 1px solid rgba(243, 238, 228, .14); }
  .faq-group details:last-child { border-bottom: 1px solid rgba(243, 238, 228, .14); }
  .faq-list summary { display: flex; justify-content: space-between; align-items: center; gap: 24px; padding: 24px 0; list-style: none; cursor: pointer; font-family: var(--serif); font-weight: 500; font-size: clamp(22px, 1.8vw, 30px); line-height: 1.2; transition: color .3s; }
  .faq-list summary::-webkit-details-marker { display: none; }
  .faq-list summary:hover { color: var(--gold); }
  .faq-list summary i { position: relative; width: 16px; height: 16px; flex: none; }
  .faq-list summary i::before, .faq-list summary i::after { content: ""; position: absolute; left: 0; top: 7.5px; width: 16px; height: 1px; background: currentColor; transition: transform .6s var(--ease-out); }
  .faq-list summary i::after { transform: rotate(90deg); }
  .faq-list details[open] summary i::after { transform: rotate(0); }
  .faq-list details p { max-width: 60ch; padding: 0 0 26px; color: rgba(243, 238, 228, .76); }
  /* the answer slides open without the page jumping (browsers without ::details-content just open it) */
  .faq-list details::details-content { height: 0; overflow: clip; transition: height .8s var(--ease-inout), content-visibility .8s allow-discrete; }
  .faq-list details[open]::details-content { height: auto; }
  @media (prefers-reduced-motion: reduce) { .faq-list details::details-content { transition: none; } }
  @media (max-width: 767px) { .faq-grid { grid-template-columns: 1fr; gap: 30px; } .faq-head { position: static; } }
</style>

<script>
  import { $$, ScrollTrigger } from '../../scripts/animations/motion';
  // an open answer changes the page height: re-measure the triggers once it has settled
  let t = 0;
  $$('.faq-list details').forEach((d) => d.addEventListener('toggle', () => { clearTimeout(t); t = window.setTimeout(() => ScrollTrigger.refresh(), 850); }));
</script>
