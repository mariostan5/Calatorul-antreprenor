---
import { config } from '../../config';

const links = [
  ['Acasă', '/'],
  ['Destinații', '/destinatii'],
  ['Club', '/club'],
  ['Oportunitate', '/business-class'],
  ['Resurse', '/business-class#academie'],
  ['Contact', '#contact'],
] as const;
const here = Astro.url.pathname.replace(/\/$/, '') || '/';
// the page you are on gets the white pill (anchors never do)
const active = (h: string) => !h.includes('#') && (h === '/' ? here === '/' : here.startsWith(h));
---
<header class="nav">
  <a class="nav-brand" href="/" aria-label="Călătorul Antreprenor, acasă">
    <img src="/brand-logo.webp" alt="" width="240" height="240" />
    <span>Călătorul Antreprenor</span>
  </a>
  <nav class="nav-links" aria-label="Principal">
    {links.map(([t, h]) => <a href={h} aria-current={active(h) ? 'page' : undefined}>{t}</a>)}
  </nav>
  <div class="nav-tools">
    <a class="nav-icon" href={config.social.instagram} rel="noopener" aria-label="Instagram">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" /></svg>
    </a>
    <button class="nav-icon nav-theme" type="button" aria-label="Schimbă tema: luminoasă sau întunecată">
      <svg class="i-sun" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
      <svg class="i-moon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" /></svg>
    </button>
  </div>
  <a class="nav-cta" href={config.webinarUrl}>Alătură-te clubului</a>
  <button class="nav-burger" type="button" aria-expanded="false" aria-controls="menu" aria-label="Meniu"><i></i></button>
</header>

<div class="menu" id="menu" role="dialog" aria-modal="true" aria-label="Meniu" hidden>
  <nav aria-label="Meniu mobil">
    {links.map(([t, h], i) => <a href={h} aria-current={active(h) ? 'page' : undefined}><span class="label">{String(i + 1).padStart(2, '0')}</span><b>{t}</b></a>)}
  </nav>
  <div class="menu-foot">
    <a class="btn btn-primary" href={config.webinarUrl}>Alătură-te clubului</a>
    <button class="btn btn-secondary nav-theme" type="button">Schimbă tema</button>
  </div>
</div>

<style is:global>
  .nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 50; height: 64px;
    display: flex; align-items: stretch;
    background: color-mix(in srgb, var(--bg) 72%, transparent);
    border-bottom: 1px solid var(--line);
    -webkit-backdrop-filter: blur(16px) saturate(140%); backdrop-filter: blur(16px) saturate(140%);
  }
  .nav-brand { display: flex; align-items: center; gap: 12px; padding: 0 var(--pad); border-right: 1px solid var(--line); }
  .nav-brand img { width: 40px; height: 40px; border-radius: 50%; }
  .nav-brand span { font-family: var(--display); font-weight: 600; font-size: 17px; letter-spacing: 0; white-space: nowrap; }
  .nav-links { display: flex; align-items: center; gap: 4px; margin-left: auto; padding: 0 18px; }
  .nav-links a { padding: 7px 11px; border-radius: var(--radius); font-family: var(--mono); font-size: 11px; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); transition: color .3s, background-color .3s; }
  .nav-links a:hover { color: var(--fg); }
  .nav-links a[aria-current='page'] { background: var(--accent); color: #0A0A0A; border-radius: 999px; }
  .nav-tools { display: flex; align-items: stretch; border-left: 1px solid var(--line); }
  .nav-icon { display: grid; place-items: center; width: 52px; border: 0; border-right: 1px solid var(--line); background: none; color: var(--muted); cursor: pointer; transition: color .3s; }
  .nav-icon:hover { color: var(--fg); }
  .nav-theme .i-sun, :root[data-theme='dark'] .nav-theme .i-moon { display: none; }
  :root[data-theme='dark'] .nav-theme .i-sun { display: block; }
  /* the full-height white block */
  .nav-cta { display: flex; align-items: center; padding: 0 26px; background: var(--btn-bg); color: var(--btn-fg); font-family: var(--mono); font-size: 11px; font-weight: 500; letter-spacing: .12em; text-transform: uppercase; white-space: nowrap; transition: background-color .3s, color .3s; }
  .nav-cta:hover { background: var(--fg); color: var(--bg); }
  .nav-burger { display: none; width: 60px; border: 0; border-left: 1px solid var(--line); background: none; cursor: pointer; }
  .nav-burger i { position: relative; display: block; width: 20px; height: 1px; margin: 0 auto; background: var(--fg); }
  .nav-burger i::before, .nav-burger i::after { content: ""; position: absolute; left: 0; width: 20px; height: 1px; background: var(--fg); transition: transform .4s var(--ease-out); }
  .nav-burger i::before { top: -6px; } .nav-burger i::after { top: 6px; }
  .nav-burger[aria-expanded='true'] i { background: transparent; }
  .nav-burger[aria-expanded='true'] i::before { transform: translateY(6px) rotate(45deg); }
  .nav-burger[aria-expanded='true'] i::after { transform: translateY(-6px) rotate(-45deg); }
  @media (max-width: 1100px) {
    .nav-links, .nav-tools { display: none; }
    .nav-cta { margin-left: auto; padding: 0 16px; font-size: 10px; }
    .nav-burger { display: block; }
    .nav-brand span { display: none; }
  }

  /* mobile: a full-screen dark overlay with large mono links */
  .menu { position: fixed; inset: 64px 0 0; z-index: 49; display: flex; flex-direction: column; justify-content: space-between; padding: 6vh var(--pad) 5vh; background: var(--bg); }
  .menu[hidden] { display: none; }
  .menu nav { display: flex; flex-direction: column; border-top: 1px solid var(--line); }
  .menu nav a { display: flex; align-items: baseline; gap: 18px; padding: 16px 0; border-bottom: 1px solid var(--line); }
  .menu nav b { font-family: var(--mono); font-weight: 400; font-size: clamp(26px, 7vw, 40px); letter-spacing: .04em; text-transform: uppercase; }
  .menu nav .label { color: var(--muted); }
  .menu nav a[aria-current='page'] b { color: var(--accent-ink); }
  .menu-foot { display: flex; flex-wrap: wrap; gap: 12px; }
</style>

<script>
  import { $, $$, gsap, lenis, reducedMotion } from '../../scripts/animations/motion';

  const menu = $('#menu')!, burger = $('.nav-burger')!;

  // light / dark, remembered
  const meta = $<HTMLMetaElement>('meta[name="theme-color"]');
  $$('.nav-theme').forEach((b) => b.addEventListener('click', () => {
    const dark = document.documentElement.dataset.theme !== 'dark';
    if (dark) document.documentElement.dataset.theme = 'dark'; else delete document.documentElement.dataset.theme;
    try { localStorage.setItem('ca-theme', dark ? 'dark' : 'light'); } catch { /* private mode */ }
    meta?.setAttribute('content', dark ? '#0C0A09' : '#FAFAF9');
  }));

  const setMenu = (open: boolean) => {
    menu.hidden = !open;
    burger.setAttribute('aria-expanded', String(open));
    if (open) {
      lenis?.stop();
      if (!reducedMotion()) gsap.from($$('nav a', menu), { opacity: 0, y: 16, duration: 0.7, ease: 'expo.out', stagger: 0.05 });
      $('a', menu)!.focus();
    } else {
      lenis?.start();
    }
  };
  burger.addEventListener('click', () => setMenu(menu.hidden === true));
  $$('a', menu).forEach((a) => a.addEventListener('click', () => setMenu(false)));
  addEventListener('keydown', (e) => e.key === 'Escape' && !menu.hidden && (setMenu(false), burger.focus()));
</script>
