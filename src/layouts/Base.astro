---
import '../styles/global.css';
import { config } from '../config';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Călătorul Antreprenor · Călătorește ca un antreprenor',
  description = 'Vacanțe la prețuri de membru și o comunitate care construiește. Clubul românilor din toată lumea care călătoresc mai mult.',
} = Astro.props;
---
<!doctype html>
<html lang="ro">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#040B1F" />
    <link rel="icon" href="/logo-mark.png" />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <slot name="head" />
  </head>
  <body>
    <slot />
    <a class="wa" href={config.whatsapp} target="_blank" rel="noopener" aria-label="Scrie-ne pe WhatsApp">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2c-1.5 0-3-.4-4.3-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.4.1-.7.3-.2.3-.9.9-.9 2.2s1 2.6 1.1 2.7c.1.2 1.9 2.9 4.6 4.1 1.7.7 2.4.8 3.2.7.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3z"/></svg>
    </a>
    <script>
      import { initScroll, initReveals, initMagnetic, gsap, $ } from '../scripts/animations/motion';
      initScroll();
      initReveals();
      initMagnetic();
      const wa = $('.wa')!;
      gsap.ticker.add(() => { wa.classList.toggle("show", scrollY > innerHeight * 0.6); });
    </script>
  </body>
</html>
